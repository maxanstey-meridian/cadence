<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RootNamespace>Cadence.Host</RootNamespace>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>cadence</ToolCommandName>
        <PackageId>Cadence.Tool</PackageId>
        <Version>0.1.1-local</Version>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Cadence.Tests" />
        <ProjectReference Include="../Cadence/Cadence.csproj" />
        <PackageReference Include="Microsoft.Extensions.AI" Version="10.8.3" />
        <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.8.3" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
        <PackageReference Include="OpenAI" Version="2.12.0" />
        <PackageReference Include="System.ClientModel" Version="1.14.0" />
        <PackageReference Include="System.CommandLine" Version="2.0.0" />
        <PackageReference Include="Tandem.OpenAICompatible" Version="$(TandemVersion)" />
        <PackageReference Include="Tandem.Packets" Version="$(TandemVersion)" />
        <PackageReference Include="Tandem.Terminal" Version="$(TandemVersion)" />
    </ItemGroup>
</Project>
